# ── VLM provider keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
OLLAMA_BASE_URL=http://localhost:11434

# ── Database ──────────────────────────────────────────────────────────────────
# Override to point at a managed Postgres (Cloud SQL, RDS, Supabase, etc.)
DATABASE_URL=postgresql+asyncpg://vlm:vlm@postgres:5432/vlm

# ── Object storage (S3-compatible) ─────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=vlm-benchmark
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# URL the BROWSER uses to fetch presigned image URLs. In dev this is
# localhost:9000; in prod it's your S3 CDN / virtual-hosted-style bucket URL.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# ── Auth ──────────────────────────────────────────────────────────────────────
# 32+ random chars. `python -c 'import secrets; print(secrets.token_urlsafe(48))'`
SESSION_SECRET=change-me-please-32-or-more-chars-of-entropy
SESSION_COOKIE_NAME=vlm_session
SESSION_LIFETIME_HOURS=720    # 30 days
# First-boot admin. Only used when the users table is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to true to skip the login page entirely (every request runs as the admin
# user). Convenient for local dev or solo deployments. DO NOT enable in any
# multi-tenant or internet-exposed setup.
AUTH_DISABLED=false

# ── App ───────────────────────────────────────────────────────────────────────
SKILLS_DIR=./skills
LOG_LEVEL=INFO
# Run a skill's post-processing script on the model output after generation.
# This executes arbitrary skill-authored Python — enable only where skill
# authors are trusted (local/solo). DO NOT enable in a multi-tenant or
# internet-exposed setup.
SKILL_SCRIPTS_ENABLED=false
SKILL_SCRIPT_TIMEOUT_S=10
